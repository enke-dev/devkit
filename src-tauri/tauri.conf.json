{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevKit",
  "mainBinaryName": "DevKit",
  "version": "0.6.0",
  "identifier": "dev.enke.devkit",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build:libs && bun run bundle:sidecar && bun run prepare:sidecar && bun run build:frontend",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevKit",
        "tabbingIdentifier": "dev.enke.devkit.comparison",
        "width": 1600,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: devkit-frame: http://devkit-frame.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/devkit-node"
    ],
    "resources": {
      "sidecar-bundle": "sidecar"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3OTU4NDg5RDI1Njk5QUUKUldTdW1WYlNpWVNWRjhjWENXN2tOTVl5R1VLL29ERHpoQThJOWpMVzlCOW51bk5JQVh4SlVydlkK",
      "endpoints": [
        "https://github.com/enke-dev/devkit/releases/latest/download/latest.json"
      ]
    }
  }
}
