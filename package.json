{
  "name": "devkit",
  "version": "0.5.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "description": "Cross-platform multi-engine browser preview: WebKit, Chromium and Gecko side by side.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:libs && bun run bundle:sidecar && bun run prepare:sidecar && bun run tauri dev",
    "build": "bun --env-file=.env run build:tauri",
    "build:tauri": "tauri build",
    "build:libs": "bun run --filter @devkit/protocol build && bun run --filter @devkit/sidecar build",
    "bundle:sidecar": "bun run scripts/bundle-sidecar.ts",
    "prepare:sidecar": "bun run scripts/prepare-sidecar.ts",
    "dev:frontend": "bun run --filter @devkit/app dev",
    "build:frontend": "bun run --filter @devkit/app build",
    "generate": "bun run generate:icons",
    "generate:icons": "bun run --sequential generate:icon:*",
    "generate:icon:default": "tauri icon assets/icon-default.svg",
    "generate:icon:macos": "shx cp assets/icon-macos.icns src-tauri/icons/icon.icns",
    "sidecar:dev": "bun run --filter @devkit/sidecar dev",
    "tauri": "tauri",
    "check": "bun run --filter '*' check",
    "format": "bun --bun run --filter '*' format",
    "lint": "bun --bun run --filter '*' lint",
    "verify:screencast": "bun run --filter @devkit/sidecar verify:screencast",
    "verify:settle": "bun run --filter @devkit/sidecar verify:settle",
    "verify:recovery": "bun run --filter @devkit/sidecar verify:recovery",
    "verify:inspect": "bun run --filter @devkit/sidecar verify:inspect",
    "verify:tree": "bun run --filter @devkit/sidecar verify:tree",
    "verify:reveal": "bun run --filter @devkit/app verify:reveal",
    "verify:blocked": "bun run --filter @devkit/sidecar verify:blocked"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.3.0",
    "@enke.dev/lint": "0.13.14",
    "@schemastore/package": "1.0.5",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "24.13.6",
    "eslint": "10.10.0",
    "jiti": "2.7.0",
    "prettier": "3.9.8",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
